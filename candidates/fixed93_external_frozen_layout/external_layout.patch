+    if manifest is None:
+        raw, identity = read_metadata(candidate / 'SOURCE_MANIFEST.json')
+        expected = os.environ.get('QWEN2_FIXED93_SOURCE_MANIFEST_SHA256')
+        need(type(expected) is str and re.fullmatch('[0-9a-f]{64}', expected) and
