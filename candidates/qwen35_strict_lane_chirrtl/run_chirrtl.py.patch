+def validate_ir(raw, scope):
+    text = raw.decode('utf-8')
+    lines = [x.split(' @[', 1)[0].strip() for x in text.splitlines()]
+    need(lines and lines[0].startswith('FIRRTL version '), 'CHIRRTL header')
+    need([x for x in lines if x.startswith('circuit ')] == ['circuit StrictFp32MatrixLane :'], 'exact circuit')
+    modules, current = {}, None
+    for line in lines[1:]:
+        if not line:
+            continue
+        match = re.fullmatch(r'module ([A-Za-z0-9_]+) :', line)
+        if match:
+            current = match.group(1)
+            need(current not in modules, 'duplicate module')
+            modules[current] = []
+            continue
+        need(not line.startswith(('extmodule ', 'intmodule ', 'intrinsic ', 'class ', 'object ', 'mem ', 'cmem ', 'smem ')), 'unsupported hardware or memory')
+        if line.startswith('circuit '):
+            continue
+        need(current is not None, 'body outside module')
+        modules[current].append(line)
+    need(set(modules) == set(scope['module_ports']) == set(scope['module_edges']), 'exact nine module definitions')
+    compact = lambda s: re.sub(r'\s+', '', s)
+    edges, multiply, regs, mul_tokens = {}, [], {}, 0
+    for name, body in modules.items():
+        observed_ports = [x for x in body if x.startswith(('input ', 'output '))]
+        need(list(map(compact, observed_ports)) == list(map(compact, scope['module_ports'][name])), 'module port type/order/direction')
+        edges[name] = []
+        for line in body:
+            mul_tokens += len(re.findall(r'\bmul\(', line))
+            if line.startswith('inst '):
+                match = re.fullmatch(r'inst ([A-Za-z0-9_]+) of ([A-Za-z0-9_]+)', line)
+                need(match is not None, 'exact instance syntax')
+                edges[name].append(list(match.groups()))
+            for match in re.finditer(r'\bmul\(([^()]*)\)', line):
+                multiply.append((name, [x.strip() for x in match.group(1).split(',')]))
+            if line.startswith(('reg ', 'regreset ')):
+                need(name == 'StrictFp32MatrixLane' and line.startswith('regreset '), 'only reset top registers')
+                match = re.match(r'regreset ([A-Za-z0-9_]+) : (.+), clock, reset, ', line)
+                need(match is not None and match.group(1) not in regs, 'register reset/identity')
+                regs[match.group(1)] = match.group(2)
+    need(edges == scope['module_edges'], 'exact parent/instance/type edges; no duplicated chain')
+    need(mul_tokens == 1 and multiply == [(scope['variable_mul_module'], scope['variable_mul_operands'])], 'exact single variable multiply')
+    need({k:compact(v) for k,v in regs.items()} == {k:compact(v) for k,v in scope['top_register_types'].items()}, 'exact top stage registers')
+    return {'module_count': len(modules), 'instance_count': sum(map(len, edges.values())),
+            'variable_mul_count': len(multiply), 'module_edges': edges,
+            'top_register_count': len(regs), 'top_register_bits_source': 553,
+            'ports_match': True, 'hardware_numerics_tested': False}
+
