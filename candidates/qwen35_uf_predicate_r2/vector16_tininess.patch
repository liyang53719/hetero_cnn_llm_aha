+// Isolated software-reference policy: finite binary32 Mul, RNE only.
+// Zero is excluded as in HardFloat commonCase. This does not use host UF.
+static bool finite_mul_tiny_after(uint32_t a, uint32_t b) {
+  const unsigned ea = (a >> 23) & 255u;
+  const unsigned eb = (b >> 23) & 255u;
+  // Caller proves ea != 255 and eb != 255.
+  const uint64_t ma = (a & 0x7fffffu) | (ea ? 0x800000u : 0u);
+  const uint64_t mb = (b & 0x7fffffu) | (eb ? 0x800000u : 0u);
+  const uint64_t product = ma * mb;
+  if (!product) return false;
+  int bits = 0;
+  for (uint64_t v = product; v; v >>= 1) ++bits;
+  const int shift = int(ea ? ea : 1u) + int(eb ? eb : 1u) - 149;
+  const int scaled_bits = bits + shift;
+  if (scaled_bits != 25) return scaled_bits < 25;
+  const uint64_t threshold = (uint64_t(1) << 25) - 1;
+  // Only here: shift in [-23,24]; every shifted value fits in 48 bits.
+  return shift >= 0 ? (product << unsigned(shift)) < threshold
+                    : product < (threshold << unsigned(-shift));
+}
