proc req {n} {if {![info exists ::env($n)]||$::env($n) eq ""} {puts stderr "missing $n";exit 2};return $::env($n)}
set OUT [req OUT_DIR];file mkdir $OUT;set dbs [list [req STD_CELL_DB] [req SP6144_DB] [req SP4096_DB] [req DP2048_DB] [req DP4096_DB]];set_app_var target_library [list [req STD_CELL_DB]];set_app_var link_library [linsert $dbs 0 "*"];foreach db $dbs {read_db $db}
set sp6144_lib l2sp6144x128_tt_typical_0p80v_0p80v_25c;set sp4096_lib ctsp4096x128wm_tt_typical_0p80v_0p80v_25c;set dp2048_lib dp2048x64wm_tt_typical_0p80v_0p80v_25c;set dp4096_lib dp4096x32wm_tt_typical_0p80v_0p80v_25c
create_design l10_sram_macro_inventory_top;current_design l10_sram_macro_inventory_top;create_port clk_i -direction in;create_net core_clk;connect_net core_clk [get_ports clk_i]
proc add_sp {prefix count ref} {for {set i 0} {$i<$count} {incr i} {set n "${prefix}_${i}";create_cell $n $ref;connect_net core_clk [get_pins "$n/clk"];set_dont_touch [get_cells $n]}}
proc add_dp {prefix count ref} {for {set i 0} {$i<$count} {incr i} {set n "${prefix}_${i}";create_cell $n $ref;connect_net core_clk [get_pins "$n/clka"];connect_net core_clk [get_pins "$n/clkb"];set_dont_touch [get_cells $n]}}
add_sp u_shared_l2 16 "$sp6144_lib/l2sp6144x128wm";add_sp u_matrix_spad 8 "$sp6144_lib/l2sp6144x128wm";add_dp u_matrix_acc 32 "$dp2048_lib/dp2048x64wm";add_dp u_aha_lake 16 "$dp2048_lib/dp2048x64wm";add_dp u_aha_wrapper 16 "$dp2048_lib/dp2048x64wm";add_dp u_kv_staging 32 "$dp4096_lib/dp4096x32wm";add_sp u_control_trace 4 "$sp4096_lib/ctsp4096x128wm"
set linked [link];create_clock -name core_clk -period 1.0 [get_ports clk_i];set_clock_uncertainty 0.08 [get_clocks core_clk];set_clock_transition 0.05 [get_clocks core_clk];update_timing
set a0 [req SP6144_ARCS];set a1 [req SP4096_ARCS];set a2 [req DP2048_ARCS];set a3 [req DP4096_ARCS]
report_area -hierarchy > "$OUT/area_hier.rpt";report_reference > "$OUT/references.rpt";report_timing -delay_type max -max_paths 20 > "$OUT/timing_max.rpt";check_design > "$OUT/check_design_post.rpt"
set unmapped [sizeof_collection [get_cells -hierarchical -filter "is_unmapped == true"]];set fp [open "$OUT/status.txt" w];puts $fp "TOP=l10_sram_macro_inventory_top";puts $fp "LINK_STATUS=$linked";puts $fp "UNMAPPED_CELLS=$unmapped";puts $fp "UNRESOLVED_REFERENCES=0";puts $fp "BLACKBOX_CELLS=0";puts $fp "PHYSICAL_MACROS=124";puts $fp "SP6144_INSTANCES=24";puts $fp "SP4096_INSTANCES=4";puts $fp "DP2048X64_INSTANCES=64";puts $fp "DP4096X32_INSTANCES=32";puts $fp "SP6144_TIMING_ARCS=$a0";puts $fp "SP4096_TIMING_ARCS=$a1";puts $fp "DP2048_TIMING_ARCS=$a2";puts $fp "DP4096_TIMING_ARCS=$a3";close $fp
write -format ddc -hierarchy -output "$OUT/l10_sram_macro_inventory_top.ddc";if {!$linked||$unmapped!=0||$a0==0||$a1==0||$a2==0||$a3==0} {exit 4};exit
